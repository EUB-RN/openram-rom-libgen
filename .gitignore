__pycache__/
*.pyc

# rom_paths.py geometry cache (regenerated from the netlist)
.geometry.json

# Magic extraction intermediates. run_ext.sh / run_cap_extract.sh rebuild
# these from <macro>.gds; the flow only ever reads <macro>_cap_only.spice,
# which is what ext2spice writes at the end. The four
# <macro>_rom_base_array.ext files alone were 142 MB.
*.ext

# netgen's machine-readable LVS dump (~48 MB per macro). Nothing in the flow
# reads it; the human-readable verdict stays in <macro>.lvs.report.gz and
# <macro>_lvs.log.
*.lvs.json

# ngspice testbench decks under <macro>/char/. gen_*_tb.py rebuilds each deck
# from <macro>.sp + <macro>_cap_only.spice + char/resistance_model.json, and
# nothing in the flow ever reads a deck back -- the run's .log/.total is what
# gen_rom_lib.py measures. 204 MB across the four example macros.
**/char/*.sp

# run_addr_hold.sh: an exploratory sweep whose verdict goes to stdout. The
# per-point decks, logs, waveform .csv dumps and the .png are read by nothing.
**/char/hold/

# gmin sweep points of run_periphery_leak.sh. Only the converged value it
# writes to periph_leak_cs<n>_<corner>.total is read back.
**/char/periph_leak_*_g1e-*.log

# run_waveform_capture.sh re-runs an already-measured deck with the waveform
# kept, so that docs/img/make_figures.py can draw it. The CSVs are megabytes
# of samples and the figures they produce are what gets committed.
**/char/wave/

# User-provided ROM designs (keep documentation and directory tracker)
user/*
!user/README.md
!user/.gitkeep

