__pycache__/
*.pyc

# rom_paths.py geometry cache (regenerated from the netlist)
.geometry.json

# Magic extraction intermediates. run_ext.sh / run_cap_extract.sh rebuild
# these from <macro>.gds; the flow only ever reads <macro>_cap_only.spice,
# which is what ext2spice writes at the end. The four
# <macro>_rom_base_array.ext files alone were 142 MB.
*.ext

# netgen's machine-readable LVS dump (~48 MB per macro). Nothing in the flow
# reads it; the human-readable verdict stays in <macro>.lvs.report.gz and
# <macro>_lvs.log.
*.lvs.json
