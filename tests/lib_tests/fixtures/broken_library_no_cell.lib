/* A minimal but VALID Liberty file. The broken_*.lib fixtures next to it are
 * this file with exactly one defect each, so a test that fails on one of them
 * is pointing at that defect and nothing else. */
library (good) {
    delay_model : "table_lookup";
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    leakage_power_unit : "1mW";

    voltage_map ( VDD, 1.80 );
    voltage_map ( VSS, 0.00 );

    lu_table_template(T) {
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.001, 0.005, 0.04");
        index_2("0.002, 0.007, 0.03");
    }

    type (word) {
        base_type : array;
        data_type : bit;
        bit_width : 4;
        bit_from : 3;
        bit_to : 0;
    }

}
