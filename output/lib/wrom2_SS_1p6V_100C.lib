        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
        index_1("0.00125, 0.005, 0.04");
        index_2("0.00125, 0.005, 0.04");
    }

    type (rom_data) {
        base_type : array;
        data_type : bit;
        bit_width : 32;
        bit_from : 31;
        bit_to : 0;
    }

    type (rom_addr) {
        base_type : array;
        data_type : bit;
        bit_width : 11;
        bit_from : 10;
        bit_to : 0;
    }

cell (wrom2) {
