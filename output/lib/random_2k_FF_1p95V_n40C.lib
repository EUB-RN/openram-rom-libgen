        variable_2 : constrained_pin_transition;
        index_1("0.05, 0.2, 0.5");
        index_2("0.05, 0.2, 0.5");
    }

    type (rom_data) {
        base_type : array;
        data_type : bit;
        bit_width : 32;
        bit_from : 31;
        bit_to : 0;
    }

    type (rom_addr) {
        base_type : array;
        data_type : bit;
        bit_width : 9;
        bit_from : 8;
        bit_to : 0;
    }

cell (random_2k) {
