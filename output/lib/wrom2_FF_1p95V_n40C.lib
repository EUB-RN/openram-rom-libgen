/* -------------------------------------------------------------------
 * wrom2 -- FF_1p95V_n40C
 * AUTO-GENERATED by scripts/rom_char/gen_rom_lib.py -- DO NOT EDIT
 *
 * The OpenRAM ROM compiler does not write a .lib; this file was built
 * from the LEF pins plus the circuit structure extracted from wrom2.sp.
 *
 * Model: precharged NAND-style (series chain) ROM, NO output latch.
 *   clk0 = 0 -> bitlines precharge (dout0 all ones)
 *   clk0 = 1 -> evaluate; the selected cells discharge the bitline
 *   worst case through ~91 series NMOS (column 236);
 *   dout0 valid 9.316 ns later
 *   dout0 becomes INVALID when clk0 falls. The consumer must either
 *   sample on clk0's falling edge, or drive the macro with an inverted
 *   clock (clk0 = ~clk) and capture on the system clock's rising edge.
 *   That invalidation IS in the data: bus(dout0) carries a second
 *   timing() group with timing_type : falling_edge and a delay of
 *   1.3878 ns (clk0 falling -> dout0 leaving its valid level).
 *   It is the EARLIEST invalidation -- t_clk2pre + t_pre_50 +
 *   t_bl2dout at the smallest load -- because what must be proven
 *   is that the consumer captured BEFORE the data went away.
 *
 * SOURCE: access/t_pre come from ngspice measurements on real Magic parasitic C + that corner's OWN sky130 models; 134x256 array, worst column 236 (series NMOS 91); front end + periphery power char/periph_{active,idle}_ff.log, bitline char/col236_worst_case_parasitic_ff.log, back end + slew char/backend_ff_*.log, leakage char/col236_leak_ff.log + char/periph_leak_cs*_ff.total, column energy char/col236_energy_ff.log, active energy = mean of 10 random reads char/random_energy_ff.log
 * -- THIS corner (FF_1p95V_n40C) was simulated separately with its own
 * sky130 model files (tt/ss/ff); no fixed scaling factor was used.
 * Measurement showed that this matters: the old SS x1.85 assumption was
 * 33% optimistic against the x2.76 that was actually measured.
 * Without --access/--t-pre this script falls back to analytic defaults
 * (based on a wrong NOR model) -- for sign-off ALWAYS call it with
 * measured values, i.e. through regen_rom_libs.sh.
 *
 * ACCESS IS THE SUM OF THREE TERMS (all measured):
 *   clk0 -> precharge/wordline : 0.4725 ns
 *   precharge -> bitline 50%   : 9.3165 ns
 *   bitline -> dout0           : 0.7454 .. 0.8452 ns (vs output load)
 *   TOTAL (worst load)         : 10.6342 ns
 * The back-end term covers the bitline inverter, the 256:32 column
 * mux and the output buffer.
 *
 * HOLD IS NOT MEASURED. It is declared equal to access
 * (10.6342 ns) because the row decoder is clocked: an address
 * that moves during evaluate drops a second wordline and that
 * wordline does not come back inside the cycle. Safe, and
 * pessimistic -- scripts/rom_char/run_hold_bisect.sh measures
 * where the real limit is for the ADDRESS. cs0 is a separate
 * question and keeps this window either way: it gates the
 * precharge, so losing it mid-evaluate ends the read outright.
 * cs0 also carries a CLOCK-GATING pair against clk0. It
 * gates the array's internal clock, and the read lives only
 * during the high phase, so the requirement is that cs0 may
 * change only while clk0 is LOW. That is a phase, not a
 * duration, and no setup/hold number can express it.
 *
 * COLUMN DECODER (measured, run_coldec_delay.sh): precharge ->
 *   column select takes 0.3546 ns against 9.3165 ns for the
 *   bitline, i.e. the mux is open 26x earlier than the data
 *   needs it. It shares the precharge edge with the discharge
 *   rather than following it, so it adds NOTHING to access.
 *   This used to be an estimate; it is now a measurement.
 *
 *
 * SETUP IS A PATH DELAY, AND IT WINS ITS RACE BY 0.1749 ns.
 *   addr0 -> the clocked decoder NAND : 0.0204 ns (measured)
 *   clk0  -> the same gate (clk_int)  : 0.1953 ns (measured)
 *   so the requirement AT THE PIN is -0.1749 ns -- negative, i.e.
 *   the address may arrive after clk0 rises and still be in time.
 *   The library ships the positive path delay instead: it is the
 *   conservative of the two, and a constraint is not relaxed as a
 *   side effect of changing what is being counted.
 *   cs0 CARRIES THE SAME NUMBER AND IS COVERED BY IT. Its path
 *   has no stage to measure -- in the netlist cs0 goes straight
 *   to the A gate of rom_control_nand and the extraction keeps it
 *   as one node -- while the address path has an inverter that
 *   cs0's does not. cs0's requirement is therefore strictly the
 *   smaller, and the address's measurement bounds it.
 *
 * INPUT PIN CAPACITANCES ARE MEASURED (run_pin_cap.sh):
 *   C = Q(VDD)/VDD, the charge the pin itself supplies over a full
 *   swing -- its wire C, the gate C of the first stage it drives,
 *   and the Miller charge pushed back as that stage switches.
 *   addr0    0.0091 pF  (worst of 11 bits, 0.0062 .. 0.0091)
 *   clk0     0.0048 pF
 *   cs0      0.0056 pF
 *   A bus carries ONE Liberty capacitance, so the ranged pin
 *   takes the WORST bit: telling a driver it will find less
 *   load than it does is the unsafe direction. The per-bit
 *   spread is above; it is real, not measurement noise.
 *
 * BOTH AXES OF THE TABLE ARE MEASURED.
 *   index_2 (output load)  : the back-end term, 0.7454 .. 0.8452 ns
 *   index_1 (clk0 slew)    : the front-end term, 0.4603 .. 0.4725 ns
 *     at clk0 transitions 0.05, 0.2, 0.5 ns
 * t_front is the only term that depends on the clk0 edge: the
 * bitline measurement triggers off the internal precharge net and
 * the back end is driven by the bitline, so neither can see clk0.
 * That is also why the output transition table stays flat along
 * index_1.
 * max_transition on the inputs is 0.5 ns, the top of that axis --
 * the library cannot declare a slew it was never measured at.
 *
 * EARLY PATH (retain_rise/retain_fall on dout0): dout0 keeps the
 * PREVIOUS cycle's value for 1.5902 .. 1.6024 ns after clk0 rises.
 * Measured on the FASTEST ARRAY this geometry can hold, where
 * everything else in this file uses the worst column. A stored 0
 * is a metal strap and leaves the series path; a stored 1 is a
 * transistor in it, so the discharge speed is set by the CONTENTS.
 * The bound therefore comes from the limit case -- every data
 * cell strapped out, with only the foot transistor left in series
 * -- and stays valid if this geometry is reprogrammed. At that
 * limit the bound is set by the fixed circuitry (foot transistor,
 * precharge PMOS, bitline wire and inverter) rather than by the
 * array, which is why it must be measured per macro but not
 * per .bin. Without it the tool believes the old data is held
 * right up to the access time and a race that eats it before the
 * capture flop takes it passes silently: a hold check has nothing
 * to fail on.
 * retaining_rise/fall is the smallest-load output slew, not a
 * separate measurement.
 * Output transition time MEASURED: 0.2128 .. 0.3176 ns
 *
 * POWER MODEL: internal_power on clk0 is ENERGY PER CYCLE (pJ);
 * the power tool applies the frequency (P = E*f*activity).
 *   when "cs0"  = 126.9724 pJ  (read: column array + periphery)
 *     MODELLED AS THE AVERAGE OF 10 RANDOM READS, not the
 *     worst case. A bitline draws recharge current only if
 *     it discharged, and it discharges only where the
 *     SELECTED ROW holds a zero -- a stored one is an NMOS
 *     whose gate has just fallen, which opens the series
 *     chain and leaves that bitline at VDD. So each
 *     sampled read is scored as
 *       <zeros in the selected row> x E_column + E_periphery
 *     with both energy terms measured and only the activity
 *     counted from the netlist's own cell types.
 *     The all-columns-discharge worst case is 244.0980 pJ
 *     (1.92x this number); use it for a current budget,
 *     not for an average-power figure.
 *     The sample is drawn with a seed derived from the
 *     macro name ALONE, so it is reproducible AND all
 *     three corners read the same addresses: which
 *     columns discharge is set by the ROM contents, not
 *     by the corner, so a per-corner draw would put pure
 *     sampling noise into the corner ratios.
 *     The per-read table is in char/random_energy_*.log.
 *   when "!cs0" = 4.0988 pJ  (IDLE: cs0 only gates the
 *     precharge; the clk_int tree, the address buffers, the row
 *     decoder and 134 wordlines switch even when deselected.
 *     Leave this block out and OpenSTA silently scores it 0.)
 *
 * LEAKAGE covers the ARRAY AND THE PERIPHERY, both measured with
 * .op in the same idle state (clk0 low):
 *   when "cs0"  = 0.000240 mW
 *   when "!cs0" = 0.000240 mW
 *   cell_leakage_power = 0.000240 mW, the worse of the two.
 *   THE TWO STATES AGREE, and that is a measurement rather
 *   than a copy: both were run, every block the macro
 *   instantiates was in both decks, and they came out equal
 *   to the digits printed here. cs0 gates the precharge PATH,
 *   so it changes what the macro does on a clock edge -- it
 *   does not change the static state the idle macro sits in,
 *   which is what a leakage number describes.
 * The periphery half is one slice per block times a count from
 * the netlist (run_periphery_leak.sh), gmin-swept: gmin is added
 * in parallel with the leakage and at the pA level it becomes the
 * answer, so each slice is taken where the sweep stops moving.
 * ----------------------------------------------------------------- */
library (wrom2_FF_1p95V_n40C) {
    delay_model : "table_lookup";
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    resistance_unit : "1kohm";
    capacitive_load_unit(1, pF);
    leakage_power_unit : "1mW";
    pulling_resistance_unit : "1kohm";

    operating_conditions(OC) {
        process : 1.0;
        voltage : 1.95;
        temperature : -40;
    }
    default_operating_conditions : OC;
    nom_process : 1.0;
    nom_voltage : 1.95;
    nom_temperature : -40;

    input_threshold_pct_fall       : 50.0;
    output_threshold_pct_fall      : 50.0;
    input_threshold_pct_rise       : 50.0;
    output_threshold_pct_rise      : 50.0;
    slew_lower_threshold_pct_fall  : 10.0;
    slew_upper_threshold_pct_fall  : 90.0;
    slew_lower_threshold_pct_rise  : 10.0;
    slew_upper_threshold_pct_rise  : 90.0;

    default_cell_leakage_power    : 0.0;
    default_leakage_power_density : 0.0;
    default_input_pin_cap    : 1.0;
    default_inout_pin_cap    : 1.0;
    default_output_pin_cap   : 0.0;
    default_max_transition   : 0.3811;
    default_fanout_load      : 1.0;
    default_max_fanout       : 4.0;
    default_connection_class : universal;

    voltage_map ( VCCD1, 1.95 );
    voltage_map ( VSSD1, 0.00 );

    lu_table_template(CELL_TABLE) {
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1("0.05, 0.2, 0.5");
        index_2("0.0017224999999999999, 0.006889999999999999, 0.027559999999999998");
    }

    lu_table_template(CONSTRAINT_TABLE) {
        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
        index_1("0.05, 0.2, 0.5");
        index_2("0.05, 0.2, 0.5");
    }

    type (rom_data) {
        base_type : array;
        data_type : bit;
        bit_width : 32;
        bit_from : 31;
        bit_to : 0;
    }

    type (rom_addr) {
        base_type : array;
        data_type : bit;
        bit_width : 11;
        bit_from : 10;
        bit_to : 0;
    }

cell (wrom2) {
    memory() {
        type : rom;
        address_width : 11;
        word_width : 32;
    }
    interface_timing : true;
    dont_use   : true;
    map_only   : true;
    dont_touch : true;
    area : 61710.0390;

    pg_pin(vccd1) {
        voltage_name : VCCD1;
        pg_type : primary_power;
    }
    pg_pin(vssd1) {
        voltage_name : VSSD1;
        pg_type : primary_ground;
    }

    leakage_power () {
        when : "cs0";
        related_pg_pin : vccd1;
        value : 0.000240;
    }
    leakage_power () {
        when : "!cs0";
        related_pg_pin : vccd1;
        value : 0.000240;
    }
    cell_leakage_power : 0.000240;

    bus(dout0) {
        bus_type : rom_data;
        direction : output;
        max_capacitance : 0.027559999999999998;
        min_capacitance : 0.0017224999999999999;
        memory_read() {
            address : addr0;
        }
        pin(dout0[31:0]) {
        related_power_pin  : vccd1;
        related_ground_pin : vssd1;
        timing() {
            timing_sense : non_unate;
            related_pin : "clk0";
            timing_type : rising_edge;
            cell_rise(CELL_TABLE) {
            values("10.5222, 10.5464, 10.6220",\
                    "10.5280, 10.5522, 10.6278",\
                    "10.5344, 10.5586, 10.6342");
            }
            cell_fall(CELL_TABLE) {
            values("10.5222, 10.5464, 10.6220",\
                    "10.5280, 10.5522, 10.6278",\
                    "10.5344, 10.5586, 10.6342");
            }
            rise_transition(CELL_TABLE) {
            values("0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176");
            }
            fall_transition(CELL_TABLE) {
            values("0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176");
            }
            retain_rise(CELL_TABLE) {
            values("1.5902, 1.5902, 1.5902",\
                    "1.5960, 1.5960, 1.5960",\
                    "1.6024, 1.6024, 1.6024");
            }
            retain_fall(CELL_TABLE) {
            values("1.5902, 1.5902, 1.5902",\
                    "1.5960, 1.5960, 1.5960",\
                    "1.6024, 1.6024, 1.6024");
            }
            retaining_rise(CELL_TABLE) {
            values("0.2128, 0.2128, 0.2128",\
                    "0.2128, 0.2128, 0.2128",\
                    "0.2128, 0.2128, 0.2128");
            }
            retaining_fall(CELL_TABLE) {
            values("0.2128, 0.2128, 0.2128",\
                    "0.2128, 0.2128, 0.2128",\
                    "0.2128, 0.2128, 0.2128");
            }
        }
        timing() {
            timing_sense : non_unate;
            related_pin : "clk0";
            timing_type : falling_edge;
            cell_rise(CELL_TABLE) {
            values("1.3878, 1.3878, 1.3878",\
                    "1.3878, 1.3878, 1.3878",\
                    "1.3878, 1.3878, 1.3878");
            }
            cell_fall(CELL_TABLE) {
            values("1.3878, 1.3878, 1.3878",\
                    "1.3878, 1.3878, 1.3878",\
                    "1.3878, 1.3878, 1.3878");
            }
            rise_transition(CELL_TABLE) {
            values("0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176");
            }
            fall_transition(CELL_TABLE) {
            values("0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176",\
                    "0.2128, 0.2320, 0.3176");
            }
        }
        }
    }

    bus(addr0) {
        bus_type : rom_addr;
        direction : input;
        capacitance : 0.0090962;
        max_transition : 0.5;
        pin(addr0[10:0]) {
        related_power_pin  : vccd1;
        related_ground_pin : vssd1;
        timing() {
            timing_type : setup_rising;
            related_pin : "clk0";
            rise_constraint(CONSTRAINT_TABLE) {
                values("0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204");
            }
            fall_constraint(CONSTRAINT_TABLE) {
                values("0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204");
            }
        }
        timing() {
            timing_type : hold_rising;
            related_pin : "clk0";
            rise_constraint(CONSTRAINT_TABLE) {
                values("10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342");
            }
            fall_constraint(CONSTRAINT_TABLE) {
                values("10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342");
            }
        }
        }
    }

    pin(cs0) {
        direction : input;
        capacitance : 0.0055646;
        max_transition : 0.5;
        related_power_pin  : vccd1;
        related_ground_pin : vssd1;
        timing() {
            timing_type : setup_rising;
            related_pin : "clk0";
            rise_constraint(CONSTRAINT_TABLE) {
                values("0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204");
            }
            fall_constraint(CONSTRAINT_TABLE) {
                values("0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204");
            }
        }
        timing() {
            timing_type : hold_rising;
            related_pin : "clk0";
            rise_constraint(CONSTRAINT_TABLE) {
                values("10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342");
            }
            fall_constraint(CONSTRAINT_TABLE) {
                values("10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342",\
                    "10.6342, 10.6342, 10.6342");
            }
        }
        timing() {
            timing_type : clock_gating_setup_rising;
            related_pin : "clk0";
            rise_constraint(CONSTRAINT_TABLE) {
                values("0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204");
            }
            fall_constraint(CONSTRAINT_TABLE) {
                values("0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204",\
                    "0.0204, 0.0204, 0.0204");
            }
        }
        timing() {
            timing_type : clock_gating_hold_falling;
            related_pin : "clk0";
            rise_constraint(CONSTRAINT_TABLE) {
                values("0.0000, 0.0000, 0.0000",\
                    "0.0000, 0.0000, 0.0000",\
                    "0.0000, 0.0000, 0.0000");
            }
            fall_constraint(CONSTRAINT_TABLE) {
                values("0.0000, 0.0000, 0.0000",\
                    "0.0000, 0.0000, 0.0000",\
                    "0.0000, 0.0000, 0.0000");
            }
        }
    }

    pin(clk0) {
        clock : true;
        direction : input;
        capacitance : 0.0048446999999999995;
        max_transition : 0.5;
        related_power_pin  : vccd1;
        related_ground_pin : vssd1;
        timing() {
            timing_type : "min_pulse_width";
            related_pin : clk0;
            rise_constraint(scalar) { values("10.9592"); }
            fall_constraint(scalar) { values("10.2052"); }
        }
        timing() {
            timing_type : "minimum_period";
            related_pin : clk0;
            rise_constraint(scalar) { values("21.1644"); }
            fall_constraint(scalar) { values("21.1644"); }
        }
        internal_power() {
            related_pg_pin : vccd1;
            when : "cs0";
            rise_power(scalar) { values("126.9724"); }
            fall_power(scalar) { values("126.9724"); }
        }
        internal_power() {
            related_pg_pin : vccd1;
            when : "!cs0";
            rise_power(scalar) { values("4.0988"); }
            fall_power(scalar) { values("4.0988"); }
        }
    }

}
}
